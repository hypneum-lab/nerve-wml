From 13b104ee8ae446e05ae922b2bbd0ffb42302ad21 Mon Sep 17 00:00:00 2001
From: electron-rare <108685187+electron-rare@users.noreply.github.com>
Date: Sat, 31 Oct 2026 22:28:00 +0100
Subject: [PATCH 3/3] fix(cmake): match x86 char and FP semantics

On non-x86 Linux, force signed char and disable FMA contraction
so level generation and physics stay comparable with x86 builds.
---
 procgen/CMakeLists.txt | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/procgen/CMakeLists.txt b/procgen/CMakeLists.txt
index ce42faf..cd31339 100644
--- a/procgen/CMakeLists.txt
+++ b/procgen/CMakeLists.txt
@@ -32,6 +32,10 @@ if (APPLE OR UNIX)
     else()
       set(CMAKE_CXX_FLAGS_RELWITHDEBINFO "${CMAKE_CXX_FLAGS_RELWITHDEBINFO} -march=native")
     endif()
+  elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
+    # keep x86 semantics: plain char is unsigned on aarch64 Linux, and GCC
+    # fuses a*b+c into FMA there (the ivybridge x86 build has no FMA)
+    set(CMAKE_CXX_FLAGS_RELWITHDEBINFO "${CMAKE_CXX_FLAGS_RELWITHDEBINFO} -fsigned-char -ffp-contract=off")
   endif()
 
   # leave frame pointers so that profiling tools will still work
