From 8e87624657fdc733b906512ccb66df5aae16721f Mon Sep 17 00:00:00 2001
From: electron-rare <108685187+electron-rare@users.noreply.github.com>
Date: Sat, 31 Oct 2026 22:27:41 +0100
Subject: [PATCH 1/3] fix(setup): allow filelock 4.x

Drop the <4.0.0 upper bound. builder.py only uses
FileLock(path) as a context manager, which is unchanged in 4.x.
---
 setup.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/setup.py b/setup.py
index 76b0ff2..f0ff47f 100644
--- a/setup.py
+++ b/setup.py
@@ -90,7 +90,7 @@ setup(
         "numpy>=1.17.0,<2.0.0",
         "gym>=0.15.0,<1.0.0",
         "gym3>=0.3.3,<1.0.0",
-        "filelock>=3.0.0,<4.0.0",
+        "filelock>=3.0.0",
     ],
     python_requires=">=3.6.0",
     package_data={
